language js

or {
  `const $n = ($a) => $b` where {
    register_diagnostic(span=$n, message="Declare functions with `function name() {}`; do not assign arrow functions to bindings.", severity="warn")
  },
  `const $n = async ($a) => $b` where {
    register_diagnostic(span=$n, message="Declare functions with `function name() {}`; do not assign arrow functions to bindings.", severity="warn")
  },
  `$x` where {
    $x <: r"(?s)let\s+\w+\s*=\s*(?:async\s+)?(?:\([^)]*\)|\w+)\s*=>.*;",
    not $x <: within r"export\s[^;]*;" ,
    register_diagnostic(span=$x, message="Declare functions with `function name() {}`; do not assign arrow functions to bindings.", severity="warn")
  },
  `$x` where {
    $x <: r"(?s)\$:\s*\w+\s*=\s*\(\s*(?:async\s+)?\(\)\s*=>.*\)\s*\(\)\s*;",
    register_diagnostic(span=$x, message="Declare functions with `function name() {}`; do not assign arrow functions to bindings.", severity="warn")
  },
  `$x` where {
    $x <: r"(?s)\$:\s*\w+\s*=\s*(?:\([^)]*\)|\w+)\s*=>.*;",
    register_diagnostic(span=$x, message="Declare functions with `function name() {}`; do not assign arrow functions to bindings.", severity="warn")
  }
}
