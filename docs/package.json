{
  "private": true,
  "scripts": {
    "dev": "bun run format-component-api && bun run --parallel index-docs dev:server",
    "dev:server": "bun scripts/dev.ts",
    "build": "bun run format-component-api && bun run --parallel build:index-docs build:sitemap && bun run build:md-docs && bun run build:site",
    "index-docs": "bun scripts/index-docs.ts",
    "build:index-docs": "bun scripts/index-docs.ts",
    "build:md-docs": "bun scripts/generate-md-docs.ts",
    "build:sitemap": "bun scripts/generate-sitemap.ts",
    "format-component-api": "bun scripts/format-component-api.ts",
    "build:site": "bun scripts/build.ts",
    "typecheck:examples": "bun scripts/typecheck-examples.ts",
    "render:examples": "bun scripts/render-examples.ts",
    "eval:search": "bun scripts/index-docs.ts && bun scripts/search-eval.ts",
    "preview": "deserved dist --spa --no-dir",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@ibm/plex-mono": "1.1.0",
    "@ibm/plex-sans": "1.1.0",
    "bun-plugin-page": "^0.3.1",
    "carbon-icons-svelte": "^13.18.2",
    "carbon-pictograms-svelte": "^13.21.1",
    "carbon-preprocess-svelte": "^0.14.4",
    "deserved": "^0.8.0",
    "svelte-ast": "^0.15.1",
    "svelte-bun": "^0.5.0"
  },
  "type": "module"
}
