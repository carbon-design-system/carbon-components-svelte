  const nodes = [
    {
      id: "europe",
      text: "Europe",
      nodes: [
        {
          id: "france",
          text: "France",
          nodes: [
            { id: "paris", text: "Paris" },
            { id: "lyon", text: "Lyon" },
            { id: "nice", text: "Nice" },
          ],
        },
        {
          id: "germany",
          text: "Germany",
          nodes: [
            { id: "berlin", text: "Berlin" },
            { id: "munich", text: "Munich" },
          ],
        },
        { id: "iceland", text: "Iceland", disabled: true },
      ],
    },
    {
      id: "north-america",
      text: "North America",
      nodes: [
        {
          id: "us",
          text: "United States",
          nodes: [
            { id: "new-york", text: "New York" },
            { id: "san-francisco", text: "San Francisco" },
          ],
        },
        { id: "canada", text: "Canada", nodes: [{ id: "toronto", text: "Toronto" }] },
      ],
    },
    { id: "antarctica", text: "Antarctica" },
  ];

  const sizes = ["xs", "sm", undefined, "lg"];
