{
  "name": "carbon-components-svelte",
  "version": "0.113.0",
  "license": "Apache-2.0",
  "description": "Svelte implementation of the Carbon Design System",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js"
    },
    "./syntax": {
      "types": "./src/syntax/index.d.ts",
      "svelte": "./src/syntax/index.js",
      "import": "./src/syntax/index.js"
    },
    "./tokens": {
      "types": "./src/tokens/index.d.ts",
      "import": "./src/tokens/index.js"
    },
    "./css/*.css": {
      "types": "./css/css.d.ts",
      "default": "./css/*.css"
    },
    "./src/*.svelte": {
      "types": "./src/*.svelte.d.ts",
      "import": "./src/*.svelte"
    },
    "./src/*.js": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    },
    "./src/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    }
  },
  "sideEffects": [
    "css/*.css"
  ],
  "scripts": {
    "setup": "bun ci && bun build:docs && bun build:css && cd docs && bun ci",
    "test": "vitest",
    "test:changed": "bunx --bun bivium run --suite unit",
    "test:changed:e2e": "bunx --bun bivium run --suite e2e",
    "test:plan": "bunx --bun bivium plan --json",
    "test:failed": "vitest run --lastFailed --passWithNoTests",
    "test:perf": "NODE_ENV=production vitest run --config vite.config.perf.ts --no-file-parallelism",
    "bench": "ostia bench",
    "bench:ab": "ostia ab --base origin/master $(ls bench/*.bench.ts | grep -v '\\.dom\\.')",
    "test:src-types": "bun check --project tsconfig.types.json",
    "test:src-svelte": "svelte-typecheck --workspace src --tsconfig ../tsconfig.svelte-types.json --no-declarations --checker bun --fail-on-warnings",
    "test:package-exports": "bun check --project tsconfig.package-exports.json",
    "test:types": "svelte-typecheck --workspace tests --checker bun",
    "test:svelte3": "cd tests-svelte3 && bunx vitest",
    "test:types:svelte3": "cd tests-svelte3 && bun run test:types",
    "test:svelte4": "cd tests-svelte4 && bunx vitest",
    "test:types:svelte4": "cd tests-svelte4 && bun run test:types",
    "test:e2e": "playwright test",
    "lint": "bun fmt && biome check --write .",
    "lint:changed": "bun fmt --staged && biome check --write --staged --no-errors-on-unmatched .",
    "build:css": "bun scripts/build-css",
    "build:css:watch": "bun scripts/build-css --watch",
    "build:css:themes": "bun scripts/build-css --themes",
    "build:syntax-tokens": "bun scripts/build-syntax-tokens.ts",
    "build:tokens": "bun scripts/build-tokens.ts",
    "check:css": "crassus diff --entry all",
    "check:css:size": "bun scripts/check-css-size.ts",
    "check:css:overrides": "crassus dead",
    "check:css:snapshot": "crassus capture",
    "check:css:snapshot:diff": "crassus snapshot-diff",
    "check:css:usage": "crassus usage",
    "check:css:compare": "crassus compare --entry all",
    "check:css:bisect": "crassus bisect --entry all",
    "check:css:tokens": "crassus tokens",
    "check:css:coverage": "crassus coverage --entry all",
    "check:css:doctor": "crassus doctor",
    "check:package": "bun scripts/check-package-contents.ts",
    "thumbnails": "bun scripts/thumbnails.ts",
    "release:screenshots": "bun scripts/release-screenshots.ts",
    "build:docs": "bun scripts/build-docs",
    "release:build": "bun scripts/release-build",
    "postinstall": "ibmtelemetry --config=telemetry.yml",
    "release": "bun scripts/release-changelog",
    "release:docs": "bun scripts/release-changelog --docs-only"
  },
  "dependencies": {
    "@ibm/telemetry-js": "^1.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.6.5",
    "@carbon/themes": "11.84.0",
    "@carbon/type": "11.70.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "acorn": "^8.19.0",
    "bivium": "^0.4.0",
    "browserslist": "^4.29.5",
    "carbon-icons-svelte": "^13.17.0",
    "crassus": "^0.3.1",
    "flatpickr": "4.6.13",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "ostia": "^0.2.12",
    "sass-embedded": "^1.107.1",
    "sveld": "^0.40.2",
    "svelte": "^5.57.3",
    "svelte-typecheck": "^0.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbon-design-system/carbon-components-svelte.git"
  },
  "homepage": "https://svelte.carbondesignsystem.com/",
  "bugs": "https://github.com/carbon-design-system/carbon-components-svelte/issues",
  "keywords": [
    "carbon",
    "carbon components",
    "svelte",
    "component library",
    "carbon design system"
  ],
  "files": [
    "src",
    "!src/**/node_modules",
    "!src/**/.cache",
    "css/*.css",
    "css/css.d.ts",
    "telemetry.yml"
  ],
  "maintainers": [
    "Eric Liu (https://github.com/metonym)"
  ]
}
