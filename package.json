{
  "name": "carbon-components-svelte",
  "version": "0.111.1",
  "license": "Apache-2.0",
  "description": "Svelte implementation of the Carbon Design System",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js"
    },
    "./css/*.css": {
      "types": "./css/css.d.ts",
      "default": "./css/*.css"
    },
    "./src/*.svelte": {
      "types": "./src/*.svelte.d.ts",
      "import": "./src/*.svelte"
    },
    "./src/*.js": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    },
    "./src/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    }
  },
  "sideEffects": [
    "css/*.css"
  ],
  "scripts": {
    "setup": "bun ci && bun build:docs && bun build:css && cd docs && bun ci",
    "test": "vitest",
    "bench": "vitest run --config vite.bench.config.ts",
    "test:src-types": "tsgo --project tsconfig.types.json",
    "test:package-exports": "tsgo --project tsconfig.package-exports.json",
    "test:types": "svelte-check --workspace tests --tsgo --fail-on-warnings",
    "test:svelte3": "cd tests-svelte3 && bunx vitest",
    "test:types:svelte3": "cd tests-svelte3 && bun run test:types",
    "test:svelte4": "cd tests-svelte4 && bunx vitest",
    "test:types:svelte4": "cd tests-svelte4 && bun run test:types",
    "test:e2e": "playwright test",
    "lint": "biome check --write .",
    "lint:changed": "biome check --write --changed --since=master --no-errors-on-unmatched .",
    "build:css": "bun scripts/build-css",
    "build:css:watch": "bun scripts/build-css --watch",
    "build:css:themes": "bun scripts/build-css --themes",
    "build:docs": "bun scripts/build-docs",
    "postinstall": "ibmtelemetry --config=telemetry.yml",
    "release": "bun scripts/release-changelog",
    "release:docs": "bun scripts/release-changelog --docs-only"
  },
  "dependencies": {
    "@ibm/telemetry-js": "^1.5.0",
    "flatpickr": "4.6.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "browserslist": "^4.28.8",
    "carbon-icons-svelte": "^13.15.0",
    "culls": "^0.2.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "mitata": "^1.0.34",
    "sass-embedded": "^1.103.1",
    "sveld": "^0.36.10",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbon-design-system/carbon-components-svelte.git"
  },
  "homepage": "https://svelte.carbondesignsystem.com/",
  "bugs": "https://github.com/carbon-design-system/carbon-components-svelte/issues",
  "keywords": [
    "carbon",
    "carbon components",
    "svelte",
    "component library",
    "carbon design system"
  ],
  "files": [
    "src",
    "css/*.css",
    "css/css.d.ts",
    "telemetry.yml"
  ],
  "maintainers": [
    "Eric Liu (https://github.com/metonym)"
  ]
}
