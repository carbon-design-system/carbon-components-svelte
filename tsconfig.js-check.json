{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // The browser baseline (Chrome 124, Firefox 125, Safari 17.4) has
    // ES2023, and `Intl.Segmenter`.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "src/node_modules", "src/**/index.js"]
}
