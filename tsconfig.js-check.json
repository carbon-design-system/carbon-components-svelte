{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // The browser baseline (Chrome 105, Firefox 121, Safari 15.4) has the
    // ES2022 library, but not ES2023's `toSorted()` (Safari 16).
    // `Intl.Segmenter` (Firefox 125) is always feature-detected before use.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "src/node_modules", "src/**/index.js"]
}
